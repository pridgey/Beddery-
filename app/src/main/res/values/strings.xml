    <string name="setup_title">Put Beddery on your nightstand</string>
    <string name="setup_body">Pick a screensaver below, then choose how Beddery starts when your phone is charging.</string>
    <string name="setup_action">Set up</string>

    <!-- Screensavers -->
    <string name="saver_minimal">Minimal</string>
    <string name="saver_minimal_desc">A big, calm clock with the date, your next alarm and battery status. Clean and easy to read from across the room.</string>
    <string name="saver_analog">Analog</string>
    <string name="saver_analog_desc">An elegant watch face with a smooth sweeping second hand and today\'s date.</string>
    <string name="saver_flip">Flip Clock</string>
    <string name="saver_flip_desc">A retro split-flap clock. Each minute the cards flip over just like the real thing.</string>
    <string name="saver_word">Word Clock</string>
    <string name="saver_word_desc">Tells the time in words, like \"it is twenty past ten\". Dots count the minutes in between. English only.</string>
    <string name="saver_nightlight">Nightlight</string>
    <string name="saver_nightlight_desc">A dim, deep-red clock on pure black. Gives off almost no light, so it won\'t keep you awake.</string>
    <string name="saver_binary">Binary</string>
    <string name="saver_binary_desc">Hours, minutes and seconds as glowing binary dots, with the decimal digits underneath if you need a hint.</string>
    <string name="saver_bounce">Bouncing Clock</string>
    <string name="saver_bounce_desc">The time drifts around the screen and changes color at each wall. Will it ever hit the corner?</string>
    <string name="saver_charging">Charging</string>
    <string name="saver_charging_desc">Watch your battery fill up with a gentle liquid animation, plus how long until it\'s full.</string>
    <string name="saver_weather">Weather</string>
    <string name="saver_weather_desc">The time, current conditions and the next few hours of forecast, so you know what to wear tomorrow.</string>
    <string name="saver_agenda">Agenda</string>
    <string name="saver_agenda_desc">The time alongside your upcoming calendar events for today and tomorrow.</string>
    <string name="saver_world">World Clock</string>
    <string name="saver_world_desc">Your time plus clocks for the cities you care about, with day and night at a glance.</string>
    <string name="saver_photos">Photo Frame</string>
    <string name="saver_photos_desc">A slow, cinematic slideshow of photos you choose, with the time in the corner.</string>
    <string name="saver_breathe">Breathe</string>
    <string name="saver_breathe_desc">A guided breathing circle to help you unwind before sleep. Follow it in and out.</string>
    <string name="saver_ocean">Moonlit Ocean</string>
    <string name="saver_ocean_desc">Slow waves under a full moon, with its reflection shimmering on the water.</string>
    <string name="saver_aurora">Aurora</string>
    <string name="saver_aurora_desc">Northern lights ripple across a starry sky above the mountains.</string>
    <string name="saver_lava">Lava Lamp</string>
    <string name="saver_lava_desc">Warm blobs of wax rise, fall and melt into each other.</string>
    <string name="saver_fireflies">Fireflies</string>
    <string name="saver_fireflies_desc">Fireflies drift and blink over a summer meadow at night.</string>
    <string name="saver_starfield">Starfield</string>
    <string name="saver_starfield_desc">Fly through space, with the occasional jump to warp speed.</string>
    <string name="saver_orbits">Orbits</string>
    <string name="saver_orbits_desc">A miniature solar system with planets circling the sun.</string>
    <string name="saver_constellation">Constellation</string>
    <string name="saver_constellation_desc">Drifting stars that link up into shifting constellations, in your accent color.</string>
    <string name="saver_matrix">Digital Rain</string>
    <string name="saver_matrix_desc">Cascading green glyphs, straight out of a hacker movie.</string>
    <string name="saver_life">Game of Life</string>
    <string name="saver_life_desc">Conway\'s cellular automaton. Cells are born, live and die. When the world settles down, a new one begins.</string>

